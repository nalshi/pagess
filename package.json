{
  "name": "nalsh-store",
  "version": "4.0.0",
  "description": "Nalsh Ultra-Fast Storefront Engine & Theme Customizer",
  "type": "module",
  "main": "index.html",
  "private": true,
  "scripts": {
    "dev": "vite",
    "sync:templates": "node scripts/sync-templates.js",
    "dashboard:icons": "esbuild src/dashboard-icons.js --bundle --minify --outfile=js/dashboard/icons.js --format=iife",
    "studio:bundle": "esbuild src/studio/main.ts --bundle --outfile=js/studio.js --format=esm && esbuild src/studio/styles/studio.css --bundle --outfile=css/studio.css",
    "build": "tsc && npm run dashboard:icons && npm run studio:bundle && vite build && node scripts/copy-assets.js",
    "pack": "npm run build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "studio:dev": "vite --host",
    "studio:build": "npm run build",
    "serve": "npx serve dist -l 3000"
  },
  "keywords": [
    "storefront",
    "ecommerce",
    "store-builder",
    "nalsh",
    "typescript",
    "vite"
  ],
  "author": "Nalsh Team",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "lucide": "^1.53.0"
  }
}
