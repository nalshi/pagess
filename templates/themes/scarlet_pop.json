      "landscape": {
        "grid_columns": 3,
        "card_orientation": "landscape",
        "card_style": "magazine"
      },
      "add_to_cart_btn": {
        "style": "rounded_box",
        "action_animation": "scale"
      }
    },
    "navigation_settings": {
      "bottom_bar": {
        "style": "floating",
        "items": [
          {
            "id": "home",
            "label": "الرئيسية",
            "icon": "fa-home",
            "visible": true,
            "order": 1
